# File ownership manifest — ENFORCED by .githooks/pre-commit.
#
# Format:  <branch> = <space-separated path globs>
#
# A branch may only commit changes to files matching one of its globs. Anything
# else is rejected. This is what makes parallel agents safe: because no two
# branches share a path, merging their work can never conflict.
#
# `orchestrator` is the pseudo-branch covering the protected branches (master,
# main) and is the only owner of shared surface: workspace manifests, the flake,
# the harness itself, and every module two or more agents depend on.
#
# An agent that needs a file it does not own must ESCALATE rather than reach for
# it. See harness-soul.md §4.

orchestrator = *

# --- Phase 0/1 agent lanes -------------------------------------------------
# Each lane is closed under compilation: it can be implemented and tested
# without any other lane's code existing.

agent/model-config = crates/jane-model/src/config.rs configs/*.toml

agent/tokenizer = crates/jane-data/src/tokenizer.rs crates/jane-data/src/tokenizer_test.rs crates/jane-data/src/binarize.rs crates/jane-data/src/binarize_test.rs

agent/dataset = crates/jane-data/src/dataset.rs crates/jane-data/src/dataset_test.rs crates/jane-data/src/batcher.rs crates/jane-data/src/batcher_test.rs

agent/sources = crates/jane-data/src/source.rs crates/jane-data/src/source_test.rs

# Split out from agent/sources: training hyperparameters have nothing to do with
# corpus acquisition. Lanes are cut along conceptual seams, not to balance size.
agent/train-config = crates/jane-train/src/config.rs

# --- Phase 2 agent lanes — the transformer model ----------------------------
# Wave 1: standalone modules (no cross-module dependencies in their tests).
agent/rmsnorm = crates/jane-model/src/rmsnorm.rs crates/jane-model/src/rmsnorm_test.rs
agent/rope = crates/jane-model/src/rope.rs crates/jane-model/src/rope_test.rs
agent/ffn = crates/jane-model/src/ffn.rs crates/jane-model/src/ffn_test.rs

# Wave 2: depends on Wave 1 being merged (attention uses rope; model uses all).
agent/attention = crates/jane-model/src/attention.rs crates/jane-model/src/attention_test.rs
agent/model = crates/jane-model/src/model.rs crates/jane-model/src/model_test.rs
